auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
node-linker=isolated
prefer-workspace-packages=true
link-workspace-packages=true

# ---------------------------------------------------------------------------
# React Native / Expo tooling expects a flatter node_modules than pnpm's
# isolated default — native-module autolinking and several Expo CLI plugins
# scan the workspace root rather than following symlinks.
#
# Hoisting only these families keeps strict isolation everywhere else: the API
# and both web apps retain their exact dependency graphs.
#
# (Metro's own module resolution is handled in apps/mobile/metro.config.js;
#  see the comment there about NOT disabling hierarchical lookup under pnpm.)
# ---------------------------------------------------------------------------
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=react-native*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=@react-native-async-storage/*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=babel-preset-expo
