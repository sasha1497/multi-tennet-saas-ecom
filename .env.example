########################################################################
# RetailOS — Multi-Tenant Local Retail E-Commerce SaaS
# Copy to `.env` and adjust.  NEVER commit a real `.env`.
#
#   cp .env.example .env
#
# Every variable below is documented in docs/DEVELOPMENT.md.
########################################################################

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug                       # trace|debug|info|warn|error|fatal
LOG_PRETTY=true                       # pretty-print logs (dev only; false in prod -> JSON)

# ---------------------------------------------------------------------
# Domains
#   Production:  ourdomain.in, *.ourdomain.in, api.ourdomain.in
#   Development: localhost,    *.localhost,    api.localhost
# ---------------------------------------------------------------------
PLATFORM_DOMAIN=localhost             # root domain that tenant subdomains hang off
PLATFORM_PROTOCOL=http                # http | https
ADMIN_SUBDOMAIN=admin                 # admin.<PLATFORM_DOMAIN>  -> merchant/platform console
API_SUBDOMAIN=api                     # api.<PLATFORM_DOMAIN>    -> REST API
# Hostnames that must NEVER be treated as a tenant slug:
RESERVED_SUBDOMAINS=www,api,admin,app,static,cdn,assets,mail,ftp,blog,help,support,status,docs

# ---------------------------------------------------------------------
# Ports (host-side; inside docker the services talk on their own ports)
# ---------------------------------------------------------------------
API_PORT=4000
STOREFRONT_PORT=3000
MERCHANT_PORT=3001
NGINX_HTTP_PORT=80

# Host-side ports for the docker services. Defaults avoid the usual suspects
# (5432, 9000, 8080) so RetailOS can run alongside other local projects.
POSTGRES_HOST_PORT=5433
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
ADMINER_HOST_PORT=8082
REDIS_COMMANDER_HOST_PORT=8083

# ---------------------------------------------------------------------
# Master (control-plane) PostgreSQL  — PRIMARY DATABASE
#   Holds: users, tenants, domains, plans, subscriptions, tenant_databases,
#          audit logs, refresh tokens, provisioning jobs, entitlements.
# ---------------------------------------------------------------------
POSTGRES_USER=retailos
POSTGRES_PASSWORD=retailos_dev_password
POSTGRES_DB=retailos_master
POSTGRES_HOST=localhost                # `postgres` when the API itself runs in docker (compose sets this)
POSTGRES_PORT=5433
MASTER_DATABASE_URL=postgresql://retailos:retailos_dev_password@localhost:5433/retailos_master?schema=public&connection_limit=10&pool_timeout=20

# ---------------------------------------------------------------------
# Tenant database placement (the control plane CREATEs databases here)
#   Every tenant gets its OWN PostgreSQL database on this cluster by default.
#   `tenant_databases` in the master DB records real placement per tenant, so a
#   tenant can later be moved to another host/cluster without code changes.
# ---------------------------------------------------------------------
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5433
TENANT_DB_ADMIN_USER=retailos         # needs CREATEDB + CREATEROLE
TENANT_DB_ADMIN_PASSWORD=retailos_dev_password
TENANT_DB_MAINTENANCE_DB=postgres     # db used to issue `CREATE DATABASE`
TENANT_DB_NAME_PREFIX=tenant_
TENANT_DB_USER_PREFIX=tu_             # each tenant gets a least-privilege DB role
TENANT_DB_CONNECTION_LIMIT=5          # per-tenant Prisma pool size
TENANT_POOL_MAX_CONNECTIONS=25        # max simultaneously-open tenant clients in one process
TENANT_POOL_IDLE_TIMEOUT_MS=300000    # evict + $disconnect a tenant client after 5m idle
TENANT_CLUSTER_ID=local-pg-1          # logical cluster identifier recorded per tenant

# ---------------------------------------------------------------------
# Secrets
#   Generate with:  openssl rand -base64 48
#   CREDENTIALS_ENCRYPTION_KEY must decode to exactly 32 bytes (AES-256-GCM).
#     openssl rand -base64 32
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_fedcba9876543210
JWT_ACCESS_TTL=900                    # seconds (15 min)
JWT_REFRESH_TTL=2592000               # seconds (30 days)
JWT_ISSUER=retailos
CREDENTIALS_ENCRYPTION_KEY=ZGV2LW9ubHktMzJieXRlLWtleS1kby1ub3QtdXNlISE=
COOKIE_SECRET=dev_cookie_secret_change_me
INTERNAL_API_KEY=dev_internal_api_key_change_me   # service-to-service (worker -> api)

# ---------------------------------------------------------------------
# Redis — cache, rate limiting, BullMQ
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
CACHE_TTL_DEFAULT=60                  # seconds
CACHE_TTL_TENANT_RESOLUTION=300
CACHE_TTL_CATALOG=120

# ---------------------------------------------------------------------
# MySQL — SECONDARY / COMPATIBILITY database (see docs/DATABASE.md §MySQL)
#   NOT used by core domain logic. Available for future MySQL-backed modules,
#   legacy retail-software imports and migration testing.
# ---------------------------------------------------------------------
MYSQL_ENABLED=true
MYSQL_ROOT_PASSWORD=retailos_dev_root
MYSQL_USER=retailos
MYSQL_PASSWORD=retailos_dev_password
MYSQL_DATABASE=retailos_compat
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_URL=mysql://retailos:retailos_dev_password@mysql:3306/retailos_compat

# ---------------------------------------------------------------------
# Object storage (S3-compatible; MinIO locally)
# ---------------------------------------------------------------------
STORAGE_DRIVER=s3                     # s3 | local
S3_ENDPOINT=http://localhost:9100
S3_PUBLIC_ENDPOINT=http://localhost:9000   # endpoint browsers/devices can reach
S3_REGION=us-east-1
S3_BUCKET=retailos-media
S3_ACCESS_KEY=retailos
S3_SECRET_KEY=retailos_dev_password
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=./.storage          # used when STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE=5242880          # 5 MB
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif

# ---------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=mock                 # mock | razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_WEBHOOK_SECRET=dev_mock_webhook_secret

# ---------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------
MAIL_DRIVER=smtp                      # smtp | log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="RetailOS <no-reply@localhost>"

SMS_DRIVER=log                        # log | msg91 | twilio
SMS_API_KEY=
SMS_SENDER_ID=RTLOS

PUSH_DRIVER=log                       # log | fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------------------------------------------------------------------
# Security / limits
# ---------------------------------------------------------------------
RATE_LIMIT_TTL=60                     # seconds
RATE_LIMIT_LIMIT=120                  # requests per TTL per IP+tenant
AUTH_RATE_LIMIT_LIMIT=10              # login/register attempts per TTL
BCRYPT_ROUNDS=12
CORS_ALLOWED_ORIGIN_SUFFIXES=.localhost,localhost
SWAGGER_ENABLED=true                  # MUST be false in production

# ---------------------------------------------------------------------
# Queues / worker
# ---------------------------------------------------------------------
QUEUE_PREFIX=retailos
WORKER_CONCURRENCY=5
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF_MS=5000

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=retailos-api
METRICS_ENABLED=true

# ---------------------------------------------------------------------
# Frontend (Next.js) — NEXT_PUBLIC_* is exposed to the browser.
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://api.localhost/api/v1
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_APP_NAME=RetailOS
# Server-side base URL used by Next during SSR inside docker:
INTERNAL_API_URL=http://api:4000/api/v1

# ---------------------------------------------------------------------
# Mobile (Expo) — see apps/mobile/.env.example
# ---------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_PLATFORM_DOMAIN=localhost

# ---------------------------------------------------------------------
# Seed data (development only)
# ---------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@retailos.dev
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_DEFAULT_PASSWORD=Password@123
