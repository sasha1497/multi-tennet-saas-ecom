{
  "name": "@retailos/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"mobile lint runs through expo lint\"",
    "clean": "rm -rf .expo dist node_modules/.cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@retailos/api-client": "workspace:*",
    "@retailos/config": "workspace:*",
    "@retailos/types": "workspace:*",
    "@tanstack/react-query": "^5.59.16",
    "expo": "~51.0.39",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "@babel/runtime": "^7.25.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@retailos/tsconfig": "workspace:*",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
