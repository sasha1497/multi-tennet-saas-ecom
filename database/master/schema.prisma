// ---------------------------------------------------------------------------
// MASTER DATABASE — the control plane.
//
// Holds platform identity, the tenant registry, domain routing, billing and
// audit. It contains NO merchant business data: products, orders, customers and
// inventory live in per-tenant databases (see ../tenant/schema.prisma).
//
// Rule of thumb: if losing a row would break *routing or access control*, it
// belongs here. If it would break *a merchant's shop*, it belongs in the tenant DB.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/master"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

// ------------------------------------------------------------------ enums --

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETING
  DELETED
}

enum UserType {
  PLATFORM
  MERCHANT
}

enum MemberRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ProvisioningJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TenantDatabaseStatus {
  PENDING
  CREATING
  MIGRATING
  READY
  FAILED
  ARCHIVED
}

enum EntitlementSource {
  PLAN
  OVERRIDE
}

enum TokenAudience {
  ADMIN
  CUSTOMER
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  STAFF_INVITE
}

// ------------------------------------------------------------- identities --

/// Platform-level human identity. Merchants, staff and super admins all live
/// here; the *role* is on the tenant membership, not on the user.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(20)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  firstName     String   @map("first_name") @db.VarChar(80)
  lastName      String   @default("") @map("last_name") @db.VarChar(80)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(1024)
  userType      UserType @default(MERCHANT) @map("user_type")
  isSuperAdmin  Boolean  @default(false) @map("is_super_admin")
  emailVerified Boolean  @default(false) @map("email_verified")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  isActive      Boolean  @default(true) @map("is_active")

  /// Consecutive failed logins; used for progressive lockout.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships        TenantUser[]
  ownedTenants       Tenant[]            @relation("TenantOwner")
  sessions           Session[]
  verificationTokens VerificationToken[]
  auditLogs          PlatformAuditLog[]

  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@map("users")
}

/// Refresh-token session. One row per device; rotation bumps `version` and a
/// replayed older version trips reuse detection and kills the whole session.
model Session {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  audience  TokenAudience @default(ADMIN)
  /// Tenant the session was scoped to when issued (null for super admins).
  tenantId  String?       @map("tenant_id") @db.Uuid
  /// Stable id for the device/session family, mirrored in the JWT `sid` claim.
  /// Rotation keeps it; that is what lets us sign out one device.
  sessionId String        @map("session_id") @db.Uuid
  /// SHA-256 of the refresh token — never the token itself.
  tokenHash String        @unique @map("token_hash") @db.VarChar(64)
  version   Int           @default(1)

  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when this token was rotated, to detect replay of the old one.
  replacedBy String?  @map("replaced_by") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, sessionId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(6)
  metadata  Json?
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ----------------------------------------------------------------- tenant --

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(120)
  /// Subdomain label. Immutable once provisioned — it is baked into the
  /// tenant's database name and every customer's bookmarks.
  slug             String       @unique @db.VarChar(63)
  status           TenantStatus @default(PROVISIONING)
  businessCategory String?      @map("business_category") @db.VarChar(80)
  contactEmail     String       @map("contact_email") @db.VarChar(255)
  contactPhone     String?      @map("contact_phone") @db.VarChar(20)

  ownerUserId String @map("owner_user_id") @db.Uuid

  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(6)
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?   @map("suspension_reason") @db.VarChar(500)

  /// Denormalised counters for the platform console, refreshed by the
  /// `refresh-tenant-stats` job. Never read for business decisions.
  statProducts   Int       @default(0) @map("stat_products")
  statOrders     Int       @default(0) @map("stat_orders")
  statCustomers  Int       @default(0) @map("stat_customers")
  statRevenue    BigInt    @default(0) @map("stat_revenue")
  statsUpdatedAt DateTime? @map("stats_updated_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner            User                    @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members          TenantUser[]
  domains          Domain[]
  database         TenantDatabase?
  subscription     Subscription?
  entitlements     FeatureEntitlement[]
  provisioningJobs TenantProvisioningJob[]
  paymentRoutes    PaymentRoute[]

  @@index([status])
  @@index([ownerUserId])
  @@index([createdAt])
  @@map("tenants")
}

/// Membership = "this user may act inside this tenant, with this role".
/// `TenantGuard` re-reads this on every merchant request; it is the check that
/// makes a client-supplied tenant hint safe.
model TenantUser {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  role             MemberRole @default(STAFF)
  /// Grants beyond the role's defaults, e.g. give one STAFF `orders.refund`.
  extraPermissions String[]   @default([]) @map("extra_permissions")
  isActive         Boolean    @default(true) @map("is_active")
  /// Which tenant this user lands in after login.
  isDefault        Boolean    @default(false) @map("is_default")
  invitedByUserId  String?    @map("invited_by_user_id") @db.Uuid
  joinedAt         DateTime?  @map("joined_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, isActive])
  @@index([tenantId, role])
  @@map("tenant_users")
}

/// Hostname → tenant routing table. This lookup is the *only* trusted way to
/// turn an incoming Host header into a tenant id.
model Domain {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  hostname          String     @unique @db.VarChar(253)
  type              DomainType @default(SUBDOMAIN)
  isPrimary         Boolean    @default(false) @map("is_primary")
  isVerified        Boolean    @default(true) @map("is_verified")
  verificationToken String?    @map("verification_token") @db.VarChar(128)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPrimary])
  @@map("domains")
}

/// Placement + credentials for one tenant database.
///
/// `encryptedPassword` is AES-256-GCM ciphertext (see CredentialCipher). Plain
/// credentials are never stored and never leave the API process.
model TenantDatabase {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Logical cluster this tenant sits on. Moving a tenant to a bigger cluster is
  /// a change to these five columns plus a dump/restore — no code change.
  clusterId    String @default("local-pg-1") @map("cluster_id") @db.VarChar(64)
  host         String @db.VarChar(255)
  port         Int    @default(5432)
  databaseName String @unique @map("database_name") @db.VarChar(63)
  username     String @db.VarChar(63)

  encryptedPassword String @map("encrypted_password") @db.Text

  status          TenantDatabaseStatus @default(PENDING)
  schemaVersion   String?              @map("schema_version") @db.VarChar(32)
  lastMigratedAt  DateTime?            @map("last_migrated_at") @db.Timestamptz(6)
  lastHealthCheck DateTime?            @map("last_health_check") @db.Timestamptz(6)
  lastError       String?              @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([clusterId, status])
  @@map("tenant_databases")
}

/// Durable, resumable provisioning state. `idempotencyKey` is what makes a
/// retried provision safe: the same key returns the same job.
model TenantProvisioningJob {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(128)
  status         ProvisioningJobStatus @default(PENDING)
  currentStep    String?               @map("current_step") @db.VarChar(64)
  /// Steps already finished — a retry skips these.
  completedSteps String[]              @default([]) @map("completed_steps")
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(5) @map("max_attempts")
  lastError      String?               @map("last_error") @db.Text
  startedAt      DateTime?             @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?             @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("tenant_provisioning_jobs")
}

// ---------------------------------------------------------------- billing --

model Plan {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(32)
  name         String  @db.VarChar(80)
  description  String? @db.VarChar(500)
  /// Minor units (paise).
  priceMonthly Int     @default(0) @map("price_monthly")
  priceYearly  Int     @default(0) @map("price_yearly")
  currency     String  @default("INR") @db.VarChar(3)
  trialDays    Int     @default(0) @map("trial_days")
  isActive     Boolean @default(true) @map("is_active")
  isPublic     Boolean @default(true) @map("is_public")
  sortOrder    Int     @default(0) @map("sort_order")

  /// `{ "products": true, "custom_domain": false, ... }`
  features Json @default("{}")
  /// `{ "max_products": 100, "max_staff": 2 }`; -1 means unlimited.
  limits   Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@index([isActive, isPublic])
  @@map("plans")
}

model Subscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Effective feature flags per tenant. Rows sourced from PLAN are rewritten on
/// plan change; OVERRIDE rows survive and win, so support can switch one
/// feature on for one merchant without inventing a bespoke plan.
model FeatureEntitlement {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  featureKey String            @map("feature_key") @db.VarChar(64)
  enabled    Boolean           @default(true)
  limitValue Int?              @map("limit_value")
  source     EntitlementSource @default(PLAN)
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId, enabled])
  @@map("feature_entitlements")
}

// ------------------------------------------------------- payments routing --

/// Maps a gateway order id back to the tenant that owns it.
///
/// Payment webhooks arrive at a single platform endpoint with no Host-based
/// tenant context, so this index is how we find which tenant database to open —
/// without ever trusting a tenant id from the webhook body.
model PaymentRoute {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(32)
  providerOrderId String   @map("provider_order_id") @db.VarChar(128)
  tenantId        String   @map("tenant_id") @db.Uuid
  /// Payment row id inside the tenant database.
  paymentId       String   @map("payment_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerOrderId])
  @@index([tenantId])
  @@map("payment_routes")
}

/// Webhook de-duplication. A gateway may deliver the same event many times;
/// the unique index makes reprocessing a no-op.
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(32)
  eventId     String    @map("event_id") @db.VarChar(191)
  eventType   String    @map("event_type") @db.VarChar(64)
  payloadHash String    @map("payload_hash") @db.VarChar(64)
  status      String    @default("RECEIVED") @db.VarChar(24)
  error       String?   @db.Text
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

// ------------------------------------------------------------------ audit --

model PlatformAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  tenantSlug   String?  @map("tenant_slug") @db.VarChar(63)
  userId       String?  @map("user_id") @db.Uuid
  userEmail    String?  @map("user_email") @db.VarChar(255)
  action       String   @db.VarChar(64)
  resourceType String?  @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  requestId    String?  @map("request_id") @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// Applied-migration ledger for tenant databases, mirrored centrally so the
/// platform console can show schema drift across the whole fleet.
model TenantMigrationRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  migrationName String   @map("migration_name") @db.VarChar(128)
  checksum      String   @db.VarChar(64)
  appliedAt     DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  durationMs    Int      @default(0) @map("duration_ms")

  @@unique([tenantId, migrationName])
  @@index([migrationName])
  @@map("tenant_migration_records")
}
