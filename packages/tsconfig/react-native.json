{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "RetailOS React Native",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "resolveJsonModule": true
  }
}
